# Environment configuration for Autonomous Travel Disruption Concierge

# Server Settings
PROJECT_NAME="Autonomous Travel Disruption Concierge"
ENVIRONMENT="development"
DEBUG=False

# Database Configuration
# Default to SQLite async for local testing, or PostgreSQL in Docker:
# DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@postgres:5432/travel_concierge"
DATABASE_URL="sqlite+aiosqlite:///./travel_concierge.db"

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"
REDIS_CHANNEL="flight_events"

# JWT Auth Secret
SECRET_KEY="supersecret_dev_key_change_in_production_environment_please"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Policy Thresholds
POLICY_MAX_FARE_DELTA_INR=5000.0
POLICY_MAX_ARRIVAL_DELAY_HOURS=3.0
POLICY_MIN_AIRPORT_BUFFER_MINUTES=45
POLICY_MIN_CONNECTION_BUFFER_MINUTES=45

# LLM Provider & Models (production uses real google client; fakes are for tests only)
LLM_PROVIDER="google"
LLM_MODEL="gemini-1.5-flash"
LLM_GRADER_MODEL="gemini-1.5-pro"
LLM_COMPARE_MODELS="gemini-1.5-flash,gemini-1.5-pro"
GOOGLE_API_KEY=""
LLM_TEMPERATURE=0.0

# Agent Loop & Timeout Guardrails
MAX_AGENT_STEPS=6
MAX_REVISIONS=3
MAX_LLM_CALLS_PER_EVENT=6
RUN_LIVE_LLM=0
LLM_TIMEOUT_SECONDS=30
PIPELINE_TIMEOUT_SECONDS=90
LLM_MAX_CONCURRENCY=1
LLM_MIN_INTERVAL_MS=1000
LLM_MAX_RETRIES=3
LLM_MODEL_LIMITS='{"gemini-3.5-flash-lite": {"rpm": 15, "rpd": 500}, "gemini-3.1-flash-lite": {"rpm": 15, "rpd": 500}, "gemini-3.6-flash": {"rpm": 5, "rpd": 20}, "gemini-3.7-flash": {"rpm": 5, "rpd": 20}, "gemini-3.8-flash": {"rpm": 5, "rpd": 20}, "gemini-3-flash": {"rpm": 5, "rpd": 20}}'

# Token, Cost & Daily Budget Settings (Lite model prices: $0.075/Mtok in, $0.30/Mtok out)
MAX_TOKENS_PER_CALL=2048
DAILY_LLM_BUDGET_USD=10.0
DAILY_LLM_CALL_LIMIT=100
LLM_PRICE_INPUT_PER_MTOK_USD=0.075
LLM_PRICE_OUTPUT_PER_MTOK_USD=0.30
USD_TO_INR=85.0

# Notifier / Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="concierge@reroute.travel"
SENDGRID_API_KEY=""

# Poller
POLLER_INTERVAL_SECONDS=60
